@{
    var routeValues = ViewContext.RouteData.Values;
    var currentController = routeValues["controller"]?.ToString() ?? string.Empty;
    var currentAction = routeValues["action"]?.ToString() ?? string.Empty;

    var isTransactionsArea = string.Equals(currentController, "Transactions", StringComparison.OrdinalIgnoreCase);
    var isTransactionList = isTransactionsArea
        && (currentAction is "Index" or "Details" or "Report");
    var isTransactionCreate = isTransactionsArea && currentAction == "Create";

    var contentCssClass = ViewData["ContentCssClass"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Transaction Management</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <aside class="app-sidebar" id="appSidebar">
        <a class="sidebar-brand" asp-controller="Transactions" asp-action="Index">
            <span class="sidebar-brand__mark">TM</span>
            <span class="sidebar-brand__text">
                <span class="sidebar-brand__name">Transaction</span>
                <span class="sidebar-brand__tagline">Management</span>
            </span>
        </a>

        <nav class="sidebar-nav" aria-label="Main navigation">
            <div class="sidebar-heading">Main</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="sidebar-link @(isTransactionsArea ? "sidebar-link--active" : null)"
                       data-bs-toggle="collapse"
                       href="#transactionsMenu"
                       role="button"
                       aria-expanded="@(isTransactionsArea ? "true" : "false")"
                       aria-controls="transactionsMenu">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Transactions</span>
                        <i class="bi bi-chevron-right sidebar-link__caret"></i>
                    </a>
                    <div class="collapse @(isTransactionsArea ? "show" : null)" id="transactionsMenu">
                        <ul class="sidebar-submenu">
                            <li>
                                <a class="sidebar-sublink @(isTransactionList ? "sidebar-sublink--active" : null)"
                                   asp-controller="Transactions" asp-action="Index">All Transactions</a>
                            </li>
                            <li>
                                <a class="sidebar-sublink @(isTransactionCreate ? "sidebar-sublink--active" : null)"
                                   asp-controller="Transactions" asp-action="Create">New Transaction</a>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            Transaction Management &middot; v1.0
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <button type="button" class="topbar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-actions">
                <a class="topbar-btn" asp-controller="Transactions" asp-action="Index">
                    <i class="bi bi-list-ul"></i><span>Transactions</span>
                </a>
                <a class="topbar-btn" asp-controller="Transactions" asp-action="Create">
                    <i class="bi bi-plus-lg"></i><span>New</span>
                </a>
                <div class="topbar-user">
                    <span class="topbar-user__avatar">TM</span>
                    <span>Administrator</span>
                </div>
            </div>
        </header>

        <main class="app-content @contentCssClass">
            @if (TempData["StatusMessage"] is string statusMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-1"></i>@statusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year Transaction Management &middot; ASP.NET Core 9 MVC
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"
            integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"
            crossorigin="anonymous"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
